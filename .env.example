# ==============================================================================
# PRINTCV ENVIRONMENT CONFIGURATION
# Copy this file to .env.local or configure these variables in Vercel / Cloud
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless API endpoints (with ?sslmode=require)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string for Prisma CLI migrations
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secret via: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"

# The canonical base URL of your application:
# Local dev: http://localhost:3000
# Production: https://printcv.me
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. 42 INTRA API OAUTH2 CREDENTIALS (api.intra.42.fr)
# ------------------------------------------------------------------------------
# Register a new OAuth app at: https://profile.intra.42.fr/oauth/applications/new
# Set Redirect URI to: https://printcv.me/api/auth/callback/42-school
# Scopes required: public
FORTY_TWO_CLIENT_ID="u-s4t2ud-your-42-client-id"
FORTY_TWO_CLIENT_SECRET="s-s4t2ud-your-42-client-secret"

# ------------------------------------------------------------------------------
# 4. ZERO-COST AI INFERENCE PIPELINE
# ------------------------------------------------------------------------------
# Primary inference model: Google Gemini 1.5 Flash (15 RPM / 1M TPM free tier)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Secondary failover provider: Groq Llama 3.3 70B Versatile (Free tier)
# Obtain a free key from Groq Console: https://console.groq.com/
GROQ_API_KEY=""

# Tertiary optional fallback: OpenAI GPT-4o-mini
OPENAI_API_KEY=""
